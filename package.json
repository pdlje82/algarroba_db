{
  "name": "algarroba-knowledge-browser",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-assets.mjs && tsc --noEmit && vite build",
    "test:layout": "node --experimental-strip-types --test tests/layout.test.mjs",
    "test": "npm run test:layout && npm run test:scene",
    "test:scene": "node --experimental-strip-types --test tests/scene.test.mjs tests/layers-v5.test.mjs"
  },
  "dependencies": {
    "cytoscape": "3.34.4",
    "cytoscape-fcose": "2.2.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-force-graph-3d": "1.29.2",
    "react-rnd": "10.5.3",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  }
}
