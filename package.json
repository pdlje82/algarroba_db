    "test:close-layers": "node --experimental-strip-types tests/close-layers.mjs",
    "test:opening-highlight": "node --experimental-strip-types tests/opening-highlight.mjs",
    "test:close-occlusion": "node --experimental-strip-types tests/close-occlusion.mjs",
    "test:domain-update": "node --experimental-strip-types tests/domain-update.mjs",
